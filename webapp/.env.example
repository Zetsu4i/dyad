# Server
PORT=3000
# Data directory for the JSON store (apps, chats, settings, mirror snapshots)
DYAD_CLOUD_DATA_DIR=./data

# Default E2B API key used to seed new workspaces (users can override in Settings → Sandbox)
E2B_API_KEY=
# Optional: E2B domain for self-hosted E2B deployments
E2B_DOMAIN=

# Default LLM gateway seeded for the first workspace
DYAD_DEFAULT_API_BASE=https://agaam2-7dba6cfc4d0a.herokuapp.com
DYAD_DEFAULT_MODEL=openai/gpt-4.1
DYAD_DEFAULT_API_KEY=
