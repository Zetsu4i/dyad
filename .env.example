# Forge environment configuration
# Copy to .env and adjust. Never commit real keys — provider keys and the E2B
# key are entered in the Settings UI and stored in your own database.

# SQLite database location (Prisma resolves relative to prisma/schema.prisma).
DATABASE_URL=file:../db/custom.db

# Optional: default LLM provider base URL seeded for new accounts.
# A URL only — API keys are always entered per-account in Settings → Providers.
FORGE_DEFAULT_API_BASE=https://agaam2-7dba6cfc4d0a.herokuapp.com
